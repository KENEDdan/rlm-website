# PRODUCTION environment template. On the server:  cp .env.production.example .env && chmod 600 .env
# Then replace EVERY value. Generate secrets ON THE SERVER, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#   docker run --rm rlm-web:prod python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit .env. Copy FIELD_ENCRYPTION_KEYS and BLIND_INDEX_KEY to the ministry's safe storage
# (docs/BACKUP_RESTORE.md section 1) BEFORE any real data arrives.

# ---- site
DOMAIN=example.org
ACME_EMAIL=webmaster@example.org
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=example.org,www.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org
SITE_URL=https://example.org
DJANGO_ADMIN_URL=staff-change-me-to-something-random/

# ---- database and cache (internal network only)
POSTGRES_DB=rlm
POSTGRES_USER=rlm
POSTGRES_PASSWORD=change-me
# pragma: allowlist nextline secret
DATABASE_URL=postgres://rlm:change-me@db:5432/rlm
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
CELERY_BROKER_URL=redis://:change-me@redis:6379/1

# ---- personal-data encryption (NEWEST KEY FIRST). Losing these = losing encrypted data forever.
FIELD_ENCRYPTION_KEYS=change-me
BLIND_INDEX_KEY=change-me

# ---- email (transactional provider on the ministry domain; SPF/DKIM/DMARC in docs/DEPLOYMENT.md)
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Rebuilding Lives Ministry <no-reply@example.org>

# ---- bot protection (required: deploy check rlm.E001 fails without it)
TURNSTILE_SITE_KEY=change-me
TURNSTILE_SECRET_KEY=change-me

# ---- client IPs behind Cloudflare: space-separated Cloudflare ranges from
# https://www.cloudflare.com/ips/ (leave as 127.0.0.1/32 when NOT behind Cloudflare)
TRUSTED_PROXIES=127.0.0.1/32

# ---- backups: age PUBLIC key only (the private key stays off the server)
BACKUP_AGE_RECIPIENT=age1change-me
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/srv/rlm/backups
# rclone remote for the off-site copy, e.g. "offsite:rlm-backups" (configured in docker/rclone/rclone.conf)
BACKUP_REMOTE=

# ---- optional
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=WARNING
PAYMENT_WEBHOOK_SECRET=
CSP_EXTRA_SCRIPT_SRC=
