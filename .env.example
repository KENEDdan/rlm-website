# Copy to .env and replace EVERY value. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# Generate a Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or run:                 python scripts/generate_env.py > .env

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010
SITE_URL=http://localhost:8010
# Obscure admin path (letters, digits, dashes). /admin/ always returns 404.
DJANGO_ADMIN_URL=staff-portal-change-me/

POSTGRES_DB=rlm
POSTGRES_USER=rlm
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgres://rlm:change-me-db-password@db:5432/rlm
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Field encryption: comma-separated Fernet keys, NEWEST FIRST. Losing these = losing encrypted data.
FIELD_ENCRYPTION_KEYS=replace-with-generated-fernet-key
# Separate secret for email lookup hashes (blind index).
BLIND_INDEX_KEY=change-me-blind-index-secret

EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Rebuilding Lives Ministry <no-reply@example.org>

# Cloudflare Turnstile (leave blank in dev to disable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional
SENTRY_DSN=
CSP_EXTRA_SCRIPT_SRC=
PAYMENT_WEBHOOK_SECRET=

# Optional virus scan of uploads (docker compose --profile clamav). Fails closed when enabled.
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Request body caps in bytes (public pages take no uploads; keep staff cap = Caddy request_body).
MAX_PUBLIC_REQUEST_BYTES=1048576
MAX_STAFF_REQUEST_BYTES=62914560
